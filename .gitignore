# ── job-hunt stable config re-inclusions ──────────────────────────
# The blanket data/ rule above hides job-hunt stable configs.
# Re-include the directory tree and its stable JSON / schema files.
!job-hunt/data/
!job-hunt/data/*.json
!job-hunt/data/jobs/
!job-hunt/data/jobs/*.json
# raw_jobs: only re-include sample fixtures; runtime snapshots stay ignored
!job-hunt/data/raw_jobs/
!job-hunt/data/raw_jobs/*.md
!job-hunt/data/raw_jobs/manual_inbox/
!job-hunt/data/raw_jobs/manual_inbox/*
!job-hunt/data/raw_jobs/manual_job_snapshot_inbox/
!job-hunt/data/raw_jobs/manual_job_snapshot_inbox/*/
!job-hunt/data/raw_jobs/manual_job_snapshot_inbox/*/*
!job-hunt/data/raw_jobs/test_dedup_source/
!job-hunt/data/raw_jobs/test_dedup_source/*/
!job-hunt/data/raw_jobs/test_dedup_source/*/*
!job-hunt/data/raw_jobs/test_dedup_source_dry_run/
!job-hunt/data/raw_jobs/test_dedup_source_dry_run/*/
!job-hunt/data/raw_jobs/test_dedup_source_dry_run/*/*
# Re-ignore runtime snapshot directories (matched after the !raw_jobs/ re-include)
job-hunt/data/raw_jobs/ntt_labs_internship_ai/
job-hunt/data/raw_jobs/ntt_labs_internship_ai_extracted/
job-hunt/data/raw_jobs/preferred_networks_internship/
job-hunt/data/raw_jobs/preferred_networks_internship_extracted/
# Keep jobs_seen.jsonl ignored (runtime state)

node_modules/
browser-use/
agent-browser/
# Private keys
*.ppk
*.pem
privvy*
images/
__pycache__/
hermes_agent.egg-info/
wandb/
testlogs

# CLI config (may contain sensitive SSH paths)
cli-config.yaml

# Skills Hub state (lives in ~/.hermes/skills/.hub/ at runtime, but just in case)
skills/.hub/
ignored/
.worktrees/
environments/benchmarks/evals/

# Web UI build output
hermes_cli/web_dist/

# Web UI assets — synced from @nous-research/ui at build time via
# `npm run sync-assets` (see web/package.json).
web/public/fonts/
web/public/ds-assets/

# Release script temp files
.release_notes.md
mini-swe-agent/

# Nix
.direnv/
.nix-stamps/
result
website/static/api/skills-index.json
.idea/
models-dev-upstream/

# Keep job-hunt resume DOCX exporter tracked
!job-hunt/skills/resume-tailor/scripts/export_resume_artifacts.py
