{
  "version": "material_stage_executors_v2",
  "human_review_required": true,
  "auto_apply_allowed": false,
  "does_not_submit": true,
  "submission_boundary": [
    "Do not submit by default.",
    "Stop before final submission.",
    "Explicit human approval is required before any submit action."
  ],
  "stages": [
    {
      "stage": "job-normalizer",
      "required": true,
      "executor_type": "supervised_skill_or_script",
      "candidate_scripts": [
        "scripts/normalize_raw_job.py",
        "skills/job-normalizer/scripts/normalize_raw_job.py"
      ],
      "fallback_mode": "pending_supervised_skill_execution",
      "notes": "Normalize a raw job snapshot into data/jobs/<job_basename>.json."
    },
    {
      "stage": "job-fit-scorer",
      "required": true,
      "executor_type": "supervised_skill_or_script",
      "candidate_scripts": [
        "scripts/score_job_fit.py",
        "skills/job-fit-scorer/scripts/score_job_fit.py"
      ],
      "fallback_mode": "pending_supervised_skill_execution",
      "notes": "Score the normalized job against data/candidate_profile.json."
    },
    {
      "stage": "resume-tailor",
      "required": true,
      "executor_type": "supervised_skill_or_script",
      "candidate_scripts": [
        "scripts/prepare_resume_tailor_plan.py",
        "scripts/tailor_resume.py",
        "skills/resume-tailor/scripts/tailor_resume.py",
        "skills/resume-tailor/scripts/render_polished_resume_docx.py"
      ],
      "fallback_mode": "pending_supervised_skill_execution",
      "notes": "Prepare a safe review-only resume tailoring plan and material input package."
    },
    {
      "stage": "application-tracker",
      "required": true,
      "executor_type": "supervised_skill_or_script",
      "candidate_scripts": [
        "scripts/update_application_tracker.py",
        "skills/application-tracker/scripts/update_application_tracker.py"
      ],
      "fallback_mode": "pending_supervised_skill_execution",
      "notes": "Record the selected job and generated material artifacts."
    },
    {
      "stage": "submission-review-gate",
      "required": true,
      "executor_type": "supervised_skill_or_script",
      "candidate_scripts": [
        "scripts/create_submission_review_gate.py",
        "skills/submission-review-gate/scripts/create_submission_review_gate.py"
      ],
      "fallback_mode": "pending_supervised_skill_execution",
      "notes": "Create the final non-submission review gate package."
    }
  ]
}
